DB_HOST=localhost
# 5544 (not 5432) to avoid clashing with any locally installed PostgreSQL instance
DB_PORT=5544
DB_NAME=fraud_monitoring_db
DB_USER=postgres
DB_PASSWORD=postgres
# Flyway (db/migration) owns the schema; ddl-auto is "validate" only. Set to false only for a
# throwaway local DB you don't mind Hibernate free-forming (not recommended - see docs/operations.md).
FLYWAY_ENABLED=true
# 8081 (not 8080) to avoid clashing with another local service already on 8080
SERVER_PORT=8081
ML_SERVICE_URL=http://localhost:8000

# Set to false to disable auth entirely for local testing (not recommended beyond local dev)
SECURITY_ENABLED=true
# Change this in any shared/deployed environment
JWT_SECRET=local-dev-insecure-jwt-signing-secret-change-this-in-production-0123456789
JWT_EXPIRATION_MS=86400000

# Default admin auto-created on first startup if no ADMIN user exists yet
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@fraud.local
DEFAULT_ADMIN_PASSWORD=Admin@12345
DEFAULT_ADMIN_FULL_NAME=System Administrator

# Shared secret between the Spring Boot backend and ml-service (guards /score, /batch-score,
# /retrain). Blank means neither side enforces it - fine for local dev only.
ML_SERVICE_API_KEY=

# Base64-encoded 256-bit AES key for PII field encryption (Customer.email/phone, AppUser.email,
# BankingTransaction.deviceId/ipAddress). Blank disables encryption (fields stored as plaintext).
# Generate one with: openssl rand -base64 32
PII_ENCRYPTION_KEY=

# Redpanda (Kafka-compatible) streaming ingestion - see docs/streaming-ingestion.md.
# In docker-compose, the backend overrides this to redpanda:9092 (container-to-container).
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_RAW_TRANSACTIONS_TOPIC=raw-transactions
KAFKA_SCORED_TRANSACTIONS_TOPIC=scored-transactions
KAFKA_FRAUD_ALERTS_TOPIC=fraud-alerts
KAFKA_DEAD_LETTER_TOPIC=dead-letter-transactions
